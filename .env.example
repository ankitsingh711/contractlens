# --- App ---
ENV=local
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database ---
DATABASE_URL=postgresql+asyncpg://contractlens:contractlens@localhost:5433/contractlens

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage ---
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=contractlens-documents
S3_REGION=us-east-1
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- AI providers ---
# Leave unset / "mock" to run fully in demo mode with deterministic responses.
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RERANKER_PROVIDER=mock
RERANKER_MODEL=rerank-english-v3.0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=

# --- Retrieval ---
RETRIEVAL_CANDIDATE_POOL_SIZE=20
RETRIEVAL_TOP_K=5
EVIDENCE_THRESHOLD=0.15

# --- Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Budgets ---
MAX_LATENCY_MS=8000
MAX_INPUT_TOKENS=12000
MAX_OUTPUT_TOKENS=3000
MAX_COST_PER_REQUEST=0.10

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
